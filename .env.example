# postlite configuration. Copy to .env and fill in. Never commit .env.
# Generate secrets with:  node bin/postlite.js gen-secrets

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=4100
# Public HTTPS URL of this instance (behind Caddy/nginx). Meta must be able to fetch
# media from PUBLIC_URL/m/... and OAuth redirect URIs are derived from it.
PUBLIC_URL=https://social.example.com
DEFAULT_TIMEZONE=Asia/Kolkata
# DATA_DIR=data                    # sqlite + uploads live here (relative to the app dir)
# MAX_UPLOAD_MB=2048
# FFMPEG_PATH=/usr/bin/ffmpeg     # optional: video poster frames in the UI
# FFPROBE_PATH=/usr/bin/ffprobe   # optional: fallback video probing
# TRUST_PROXY=1                    # use X-Forwarded-For for login rate limiting (only behind your own proxy)
# LOG_LEVEL=info

# --- Web UI sign-in ---------------------------------------------------------
# password (default): `node bin/postlite.js set-password`.
# cloudflare-access: Cloudflare Zero Trust Access in front (email one-time PIN). postlite verifies the
# Access JWT itself and only admits ALLOWED_EMAILS. Guide: docs/setup/cloudflare-access.md
AUTH_MODE=password
# CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# CF_ACCESS_AUD=                    # Application Audience (AUD) tag of the Access application
# ALLOWED_EMAILS=you@example.com,partner@example.com
# CF_ACCESS_CLOCK_SKEW_SEC=60
# CF_ACCESS_JWKS_TIMEOUT_MS=5000

# --- Secrets --------------------------------------------------------------
# Pepper for hashing session ids at rest (sessions are random 256-bit tokens). Changing it logs everyone out.
SESSION_SECRET=
# Encrypts OAuth tokens + webhook secrets at rest (AES-256-GCM). Losing it = reconnect all accounts.
TOKEN_ENC_KEY=

# Platform app credentials are OPTIONAL here: paste them in the web UI (Settings → Platform apps).
# Values saved in the UI override these; these act as a fallback. Guides: docs/setup/README.md

# --- Meta (Facebook Pages + Instagram via Facebook Login) -----------------
META_APP_ID=
META_APP_SECRET=
GRAPH_API_VERSION=v25.0

# --- Instagram API with Instagram Login (standalone) ----------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Google / YouTube -----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Scheduler ------------------------------------------------------------
# SCHEDULER_TICK_MS=15000
# MISSED_GRACE_MINUTES=360         # overdue posts older than this at boot are marked "missed"
# MAX_ATTEMPTS=3                   # transient-error retries
# BACKOFF_BASE_MS=60000            # 1 min, 2 min, 4 min ...
# POLL_INTERVAL_MS=10000           # media-processing status polling
# MAX_PENDING_MINUTES=60
# SCHEDULER_CONCURRENCY=2

# --- Analytics ------------------------------------------------------------
# ANALYTICS_INTERVAL_HOURS=6
# ANALYTICS_BACKFILL_DAYS=30
# ANALYTICS_RECENT_POSTS=25

# --- Agents / API ---------------------------------------------------------
# ALLOW_PRIVATE_MEDIA_URLS=0       # upload_media_from_url refuses private/loopback addresses unless 1
# WEBHOOK_MAX_ATTEMPTS=6
# WEBHOOK_BACKOFF_MS=30000

# --- Testing only: point providers at fake servers (see test/fake/server.js) ---
# GRAPH_BASE_URL=  FACEBOOK_WWW_URL=  IG_GRAPH_BASE_URL=  IG_API_BASE_URL=  IG_WWW_URL=
# GOOGLE_AUTH_URL=  GOOGLE_TOKEN_URL=  YOUTUBE_API_BASE_URL=  YOUTUBE_ANALYTICS_BASE_URL=
