# Worker secrets for postlite on Cloudflare Workers.
# Production: `npx wrangler secret put NAME`. Local `wrangler dev`: copy this file to .dev.vars.
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts OAuth tokens at rest. Never change it later.
TOKEN_ENC_KEY=
# Random string (openssl rand -base64 32).
SESSION_SECRET=
